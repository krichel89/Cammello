# Cammello workflow: Frankfurter Buchmesse 2026
#
# Load it in Cammello: menu File > "Load workflow from file...", drop this
# file on the window, or double-click it. Cammello shows what it sets and
# asks first.
#
# Checked against Wikidata: Q141663636 is "Frankfurter Buchmesse 2026" and
# its Commons category (P373) is "Frankfurter Buchmesse 2026".
# NOT checked: the template names under `templates` (set after the pattern
# of the Dragon Con pages) - verify them before passing the file on.

[[workflow]]
key         = "frankfurter-buchmesse-2026"
name        = "Frankfurter Buchmesse 2026"
hide_fields = ["camera_position", "object_position", "base_captions"]
show_fields = []

  [workflow.set]
  templates      = "{{WikiPortraits Frankfurter Buchmesse 2026}}\n{{Do not crop}}"
  categories     = "Frankfurter Buchmesse 2026"
  created_during = "Q141663636"
